# Supabase Configuration (REQUIRED)
# Copia este archivo a .env y completa con tus credenciales de Supabase
# Get your credentials from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# PeerJS Configuration
# Choose between Local Server (development) or Cloud Server (production)

# Use local PeerJS server (true) or cloud server (false)
VITE_PEER_USE_LOCAL=true

# Local Server Configuration (only if USE_LOCAL=true)
VITE_PEER_HOST=localhost
VITE_PEER_PORT=9000
VITE_PEER_PATH=/myapp

# For production with custom PeerJS server in the cloud:
# VITE_PEER_USE_LOCAL=false
# VITE_PEER_HOST=your-server.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/myapp
